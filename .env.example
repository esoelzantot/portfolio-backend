MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=5000
# at least 32 chars, generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
JWT_EXPIRES_IN=1d
# comma separated; leave empty to allow any origin in development
CORS_ORIGIN=http://localhost:4200
# number of proxies in front of the app (set to 1 on Render / Railway)
TRUST_PROXY=
