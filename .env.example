MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=5000
# at least 32 chars, generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
JWT_EXPIRES_IN=1d
# Vercel -> Storage -> your Blob store -> ".env.local" tab
BLOB_READ_WRITE_TOKEN=
# only if "npm run migrate:images" tells you to set it
BLOB_PUBLIC_URL=
# comma separated; leave empty to allow any origin in development
CORS_ORIGIN=http://localhost:4200
# number of proxies in front of the app (set to 1 on Vercel / Render)
TRUST_PROXY=
# local dev only, if "querySrv ECONNREFUSED" on Windows (do NOT set on Vercel)
DNS_SERVERS=
